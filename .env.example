# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# AWS credentials for Amazon Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary (SSO/STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Claude model on Bedrock (Sonnet 5). Check the Bedrock console's model
# catalog if your account lists a different ID or needs an inference profile.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
